---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { routes, tr, ui, type Lang } from '../i18n';
import { inline, plain } from '../utils';
import { bioLong } from '../data/bio';
import { dossiers } from '../data/dossiers';
import tiorba from '../assets/fotos/tiorba.jpg';
import guitarraAzul from '../assets/fotos/guitarra-azul.jpg';
import primerPlano from '../assets/fotos/primer-plano.jpg';
import corbata from '../assets/fotos/corbata.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const other: Lang = es ? 'en' : 'es';
const words = bioLong[lang].join(' ').split(/\s+/).length;
const photos = [
  { img: tiorba, file: 'victor-cruz-tiorba-y-guitarra_Noria-Producciones.jpg', by: 'Noria Producciones', alt: { es: 'Con tiorba y guitarra barroca', en: 'With theorbo and Baroque guitar' } },
  { img: primerPlano, file: 'victor-cruz-retrato_Pablo-F-Juarez.jpg', by: 'Pablo F. Juárez', alt: { es: 'Retrato', en: 'Portrait' } },
  { img: guitarraAzul, file: 'victor-cruz-guitarra_Noria-Producciones.jpg', by: 'Noria Producciones', alt: { es: 'Con guitarra barroca', en: 'With Baroque guitar' } },
  { img: corbata, file: 'victor-cruz-traje_Pablo-F-Juarez.jpg', by: 'Pablo F. Juárez', alt: { es: 'Retrato de cuerpo medio', en: 'Half-length portrait' } },
];
---
<Base lang={lang} route="downloads" title={tr(ui.nav.downloads, lang)}
  description={es ? 'Fotos en alta resolución, biografía y dossieres de Víctor Cruz y sus proyectos, para prensa y programadores.' : 'High-resolution photos, biography and press kits of Víctor Cruz and his projects, for press and presenters.'}>
  <PageHead kicker={es ? 'Para prensa y programadores' : 'For press and presenters'} title={tr(ui.nav.downloads, lang)}
    lead={es ? 'Fotos en alta resolución, biografía y dossieres. Las fotos pueden usarse para la difusión de conciertos citando a su autor.' : 'High-resolution photos, biography and press kits. Photos may be used to promote concerts, crediting the photographer.'} />

  <section class="section" id="fotos">
    <div class="wrap">
      <h2 class="title">{es ? 'Fotos' : 'Photos'}</h2>
      <div class="photos">
        {photos.map((p) => (
          <figure>
            <a href={`/descargas/fotos/${p.file}`} download>
              <Image src={p.img} alt={`Víctor Cruz. ${tr(p.alt, lang)}`} widths={[300, 500]} sizes="(max-width: 760px) 50vw, 240px" quality={74} />
            </a>
            <figcaption>{tr(ui.photo, lang)}: {p.by}<br /><a class="more" href={`/descargas/fotos/${p.file}`} download>{es ? 'Descargar JPG' : 'Download JPG'}</a></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="biografias">
    <div class="wrap narrow">
      <div class="head-row" style="margin-bottom:0.5rem">
        <h2 class="title">{tr(ui.nav.bio, lang)}</h2>
        <button type="button" class="copy" data-copy="bio-larga">{es ? 'Copiar texto' : 'Copy text'}</button>
      </div>
      <p class="other">{words} {es ? 'palabras' : 'words'} · {es ? 'También en ' : 'Also in '}<a href={`${routes.downloads[other]}#biografias`} hreflang={other}>{tr(ui.otherLang, lang)}</a></p>
      <div class="prose" id="bio-larga" data-plain={bioLong[lang].map(plain).join('\n\n')}>
        {bioLong[lang].map((p) => <p set:html={inline(p)} />)}
      </div>
    </div>
  </section>

  <section class="section" id="dossier">
    <div class="wrap">
      <h2 class="title">Dossier</h2>
      <p class="btns" style="margin:1.2rem 0 0">
        <a class="btn btn--solid" href="/dossieresp.pdf" download>Dossier (PDF, español)</a>
        <a class="btn" href="/dossiereng.pdf" download>Press kit (PDF, English)</a>
      </p>
      <h3 class="h-sub">{es ? 'Dossieres de los proyectos' : 'Project dossiers'}</h3>
      <div class="pdoss">
        {dossiers.map((d) => (
          <div>
            <b>{tr(d.project, lang)}</b>
            <ul>
              {d.items.map((i) => {
                const links = es
                  ? [{ t: 'Español', h: i.es }, ...(i.en ? [{ t: 'English', h: i.en }] : [])]
                  : [...(i.en ? [{ t: 'English', h: i.en }] : []), { t: 'Spanish', h: i.es }];
                return (
                  <li>
                    <span set:html={inline(tr(i.label, lang))} />
                    <span class="pdoss__links">PDF: {links.map((l, n) => <>{n > 0 && ' · '}<a href={l.h} target="_blank" rel="noopener">{l.t}</a></>)}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.getElementById(btn.dataset.copy ?? '');
      if (!el) return;
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(el.dataset.plain ?? el.innerText);
        btn.textContent = document.documentElement.lang === 'es' ? 'Copiada' : 'Copied';
      } catch {
        btn.textContent = '—';
      }
      setTimeout(() => (btn.textContent = label), 1800);
    });
  });
</script>
<style>
  .photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 1.6rem; }
  .photos figure { margin: 0; }
  .photos img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
  .photos figcaption { font-family: var(--sans); font-size: 0.8rem; color: var(--gris); margin-top: 0.6rem; line-height: 1.5; }
  .photos .more { font-size: 0.72rem; }
  .h-sub { font-family: var(--sans); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--vino); margin: 2.4rem 0 1rem; }
  .pdoss { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px 32px; }
  .pdoss b { display: block; font-weight: 400; font-size: 1.2rem; color: var(--vino); margin-bottom: 0.5rem; }
  .pdoss ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .pdoss li { font-size: 1rem; line-height: 1.4; }
  .pdoss__links { display: block; font-family: var(--sans); font-size: 0.78rem; color: var(--gris); margin-top: 0.15rem; }
  .pdoss__links a { color: var(--vino); }
  .other { font-family: var(--sans); font-size: 0.9rem; color: var(--gris); }
  .other a { color: var(--vino); }
  #bio-larga { font-size: 1.08rem; margin-top: 1.4rem; }
  .copy { font-family: var(--sans); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--vino); background: none; border: 1px solid var(--vino); padding: 0.5rem 0.9rem; cursor: pointer; flex-shrink: 0; }
  .copy:hover { background: var(--vino); color: var(--marfil); }
  @media (max-width: 1000px) { .photos { grid-template-columns: repeat(3, 1fr); } .pdoss { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .photos { grid-template-columns: repeat(2, 1fr); } .pdoss { grid-template-columns: 1fr; } }
</style>
