---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { tr, ui, url, type Lang } from '../i18n';
import { inline, quote } from '../utils';
import { heroQuote, reviews, type Review } from '../data/press';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const all: Review[] = [heroQuote, ...reviews];
---
<Base lang={lang} route="press" title={tr(ui.nav.press, lang)}
  description={es ? 'Críticas de prensa sobre el barítono Víctor Cruz: Codalario, ABC de Sevilla, Ritmo, Scherzo, Beckmesser, Ópera Actual y otras.' : 'Press reviews of baritone Víctor Cruz: Codalario, ABC de Sevilla, Ritmo, Scherzo, Beckmesser, Ópera Actual and more.'}>
  <PageHead kicker={tr(ui.tagline, lang)} title={tr(ui.nav.press, lang)}
    lead={es ? 'Lo que ha escrito la crítica.' : 'What the critics say. Quotes translated from Spanish and French.'} />
  <section class="section">
    <div class="wrap">
      <div class="reviews">
        {all.map((r) => (
          <article class="review">
            <h2 class="critic">{r.author}</h2>
            {[r, ...(r.more ?? [])].map((c) => (
              <figure>
                <blockquote>
                  <p set:html={quote(inline(es ? c.q : c.en ?? c.q), lang)} />
                  {es && c.es && <p class="tr" set:html={inline(c.es)} />}
                </blockquote>
                <figcaption>
                  <span class="who"><b>{c.outlet}</b>{c.country && ` (${tr(c.country, lang)})`}</span>
                  <span class="about" set:html={inline(tr(c.about, lang))} />
                  {c.url && <a class="more" href={c.url} rel="noopener">{c.paid ? (es ? 'Leer en Kiosko y Más (de pago)' : 'Read on Kiosko y Más (paywall)') : tr(ui.readReview, lang)} ↗</a>}
                </figcaption>
              </figure>
            ))}
          </article>
        ))}
      </div>
      <p class="btns" style="margin-top:3rem"><a class="btn" href={url('downloads', lang)}>{tr(ui.nav.downloads, lang)}</a></p>
    </div>
  </section>
</Base>
<style>
  .reviews { columns: 2; column-gap: clamp(32px, 5vw, 72px); }
  .review { break-inside: avoid; margin: 0 0 3rem; padding-top: 1.2rem; border-top: 1px solid var(--linea); }
  .critic { font-family: var(--sans); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--vino); margin: 0 0 0.9rem; }
  .review figure { margin: 0; }
  .review figure + figure { margin-top: 1.6rem; }
  .review blockquote { margin: 0; }
  .review blockquote p { font: italic 300 1.35rem/1.5 var(--serif); margin: 0; }
  .review blockquote p.tr { font-size: 1.02rem; color: var(--gris); margin-top: 0.6rem; }
  .review figcaption { margin-top: 0.7rem; font-family: var(--sans); font-size: 0.86rem; line-height: 1.5; }
  .review .who { display: block; color: var(--tinta); letter-spacing: 0.03em; }
  .review .who b { font-weight: 500; color: var(--vino); }
  .review .about { display: block; color: var(--gris); }
  .review .more { font-size: 0.72rem; margin-top: 0.2rem; }
  @media (max-width: 860px) { .reviews { columns: 1; } }
</style>
