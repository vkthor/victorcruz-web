---
// Portada (maqueta A).
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import OrfeoCard from '../components/OrfeoCard.astro';
import OwnWorkText from '../components/OwnWorkText.astro';
import QuoteSlider from '../components/QuoteSlider.astro';
import { tr, ui, url, type Lang } from '../i18n';
import { inline, quote } from '../utils';
import { site } from '../data/site';
import { bioHome, ensemblesHtml, lead } from '../data/bio';
import { featured, spanish, production, wookiee, productionIntro, productionClients } from '../data/videos';
import { reviews, sliderQuotes } from '../data/press';
import { projects } from '../data/projects';
import tiorba from '../assets/fotos/tiorba.jpg';
import cantarCard from '../assets/fotos/cantar-card.jpg';
import duoCard from '../assets/fotos/duo-card.jpg';
import primerPlano from '../assets/fotos/primer-plano.jpg';
import doble from '../assets/fotos/doble.jpg';
import jdzPlaya from '../assets/fotos/jdz-playa.jpg';
import veladas from '../assets/fotos/veladas.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const homeReviews = reviews.filter((r) => r.home);
const quoteText = (r: { q: string; en?: string; es?: string }) => (es ? r.es ?? r.q : r.en ?? r.q);
---
<Base
  lang={lang}
  route="home"
  person
  description={es
    ? 'Víctor Cruz, barítono especializado en música antigua: biografía, trayectoria, vídeos, prensa y proyectos. Fundador y director de Jácaras del Zéfiro.'
    : 'Víctor Cruz, baritone specialising in early music: biography, career, videos, press and projects. Founder and director of Jácaras del Zéfiro.'}
>
  <section class="hero">
    <div class="hero__text">
      <p class="eyebrow">{tr(ui.tagline, lang)}</p>
      <h1>Víctor Cruz</h1>
      <p class="hero__lead">{tr(lead, lang)}</p>
      <p class="btns">
        <a class="btn btn--solid" href="#videos">{es ? 'Ver vídeos' : 'Watch videos'}</a>
        <a class="btn" href={url('bio', lang)}>{tr(ui.nav.bio, lang)}</a>
      </p>
    </div>
    <figure class="hero__fig">
      <!-- La foto de la tiorba nunca se recorta: siempre entera, con su proporción. -->
      <Image src={tiorba} alt={es ? 'Víctor Cruz sentado con una tiorba y una guitarra barroca' : 'Víctor Cruz seated with a theorbo and a Baroque guitar'} widths={[480, 720, 960, 1200, 1478]} sizes="(max-width: 760px) 100vw, 560px" loading="eager" fetchpriority="high" quality={84} />
      <figcaption class="credit">{tr(ui.photo, lang)}: Noria Producciones</figcaption>
    </figure>
  </section>

  <QuoteSlider items={sliderQuotes} lang={lang} />

  <section class="section" id="videos">
    <div class="wrap">
      <div class="head-row">
        <h2 class="title">{es ? 'Escuchar y ver' : 'Listen and watch'}</h2>
        <a class="more" href={url('videos', lang)}>{es ? 'Todos los vídeos' : 'All videos'} →</a>
      </div>
      <div class="vgrid">
        <OrfeoCard lang={lang} />
        <div class="vlist">
          {featured.map((v) => <VideoCard video={v} lang={lang} variant="list" />)}
        </div>
      </div>
      <h3 class="title-sm">{es ? 'Barroco español' : 'Spanish Baroque'}</h3>
      <div class="vrow">
        {spanish.map((v) => <VideoCard video={v} lang={lang} />)}
      </div>
      <p class="vnote">{tr(ui.videoConsent, lang)}</p>
    </div>
  </section>

  <section class="names">
    <h2>{es ? 'Ha cantado con' : 'He has sung with'}</h2>
    <p set:html={ensemblesHtml(lang)} />
  </section>

  <section class="section">
    <div class="wrap split">
      <figure style="margin:0">
        <Image src={primerPlano} alt={es ? 'Retrato de Víctor Cruz' : 'Portrait of Víctor Cruz'} widths={[420, 640, 840]} sizes="(max-width: 1000px) 90vw, 420px" quality={80} />
        <figcaption class="credit">{tr(ui.photo, lang)}: Pablo F. Juárez</figcaption>
      </figure>
      <div class="prose">
        <h2 class="title">{tr(ui.nav.bio, lang)}</h2>
        {bioHome[lang].map((p) => <p set:html={inline(p)} />)}
        <a class="more" href={url('bio', lang)}>{es ? 'Biografía completa' : 'Full biography'} →</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <h2 class="title">{tr(ui.nav.press, lang)}</h2>
      <div class="pq" style="margin-top:2.2rem">
        {homeReviews.map((r) => (
          <figure>
            <blockquote set:html={quote(inline(quoteText(r)), lang)} />
            <figcaption>{r.author} · <span>{r.outlet}</span></figcaption>
          </figure>
        ))}
      </div>
      <a class="more" href={url('press', lang)}>{es ? 'Más críticas' : 'More reviews'} →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <h2 class="title">{tr(ui.projectsTitle, lang)}</h2>
        <a class="more" href={url('projects', lang)}>{es ? 'Ver los proyectos' : 'See the projects'} →</a>
      </div>
      <div class="pgrid">
        <a class="pcard pcard--main" href={es ? site.jdz : site.jdzEn} rel="noopener">
          <span class="pcard__img"><Image src={jdzPlaya} alt={es ? 'Jácaras del Zéfiro con sus instrumentos en la playa' : 'Jácaras del Zéfiro with their instruments on the beach'} widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, 640px" quality={78} /></span>
          <span class="pcard__text">
            <small>{tr(projects.jdz.role, lang)}</small>
            <b>{projects.jdz.name}</b>
            <span set:html={inline(tr(projects.jdz.short, lang))} />
            <em class="go">jacarasdelzefiro.es ↗</em>
          </span>
        </a>
        <a class="pcard" href={`${url('projects', lang)}#duo`}>
          <span class="pcard__img"><Image src={duoCard} alt={es ? 'Víctor Cruz y Juan Carlos de Mulder' : 'Víctor Cruz and Juan Carlos de Mulder'} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 320px" quality={78} /></span>
          <span class="pcard__text">
            <b>{projects.duo.name}</b>
            <span set:html={inline(tr(projects.duo.short, lang))} />
            <em class="go">{es ? 'Ver el proyecto' : 'See the project'} →</em>
          </span>
        </a>
        <a class="pcard" href={`${url('projects', lang)}#baden-baden`}>
          <span class="pcard__img"><Image src={veladas} alt={es ? 'Fotograma del documental Una velada musical en Baden-Baden' : 'Still from the documentary A Musical Evening in Baden-Baden'} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 320px" quality={78} /></span>
          <span class="pcard__text">
            <b>{tr(projects.veladas.name, lang)}</b>
            <span set:html={inline(tr(projects.veladas.short, lang))} />
            <em class="go">{es ? 'Ver el documental' : 'Watch the documentary'} →</em>
          </span>
        </a>
        <a class="pcard" href={`${url('projects', lang)}#cantar`}>
          <span class="pcard__img"><Image src={cantarCard} alt={es ? 'Víctor Cruz y Blanca Martín' : 'Víctor Cruz and Blanca Martín'} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 320px" quality={78} /></span>
          <span class="pcard__text">
            <b>{projects.cantar.name}</b>
            <span set:html={inline(tr(projects.cantar.short, lang))} />
            <em class="go">{es ? 'Escuchar' : 'Listen'} →</em>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="wrap beyond">
      <figure>
        <Image src={doble} alt={es ? 'Montaje fotográfico: Víctor Cruz con traje de fantasía y con partitura de Bach' : 'Photo montage: Víctor Cruz in a fancy suit and holding a Bach score'} widths={[480, 720, 1000]} sizes="(max-width: 1000px) 90vw, 520px" quality={80} />
        <figcaption class="credit">{tr(ui.photo, lang)}: Pablo F. Juárez</figcaption>
      </figure>
      <div>
        <h2 class="title">{tr(ui.nav.beyond, lang)}</h2>
        <h3 class="sub">{es ? 'Producción audiovisual' : 'Video production'}</h3>
        <p>{tr(productionIntro, lang)} <span set:html={inline(tr(productionClients, lang))} /> <OwnWorkText lang={lang} /></p>
        <div class="prod">
          {production.slice(0, 3).map((v) => <VideoCard video={v} lang={lang} sizes="(max-width: 760px) 100vw, 260px" />)}
        </div>
        <p class="encargo">{es ? 'Encargos de vídeo' : 'Video commissions'}: <a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="mini">
          <b>{es ? 'Voz y radio' : 'Voice and radio'}</b> · <span set:html={inline(es ? 'Radio Clásica; producción, sonido y voz del pódcast [El Gallinero Real](https://www.tiktok.com/@elgallinerorealpodcast/video/7458613013956857121) (Intermezzo, Teatro Real)' : 'Radio Clásica; producer, sound engineer and voice of the podcast [El Gallinero Real](https://www.tiktok.com/@elgallinerorealpodcast/video/7458613013956857121) (Intermezzo, Teatro Real)')} /><br />
          <b>{es ? 'Docencia' : 'Teaching'}</b> · <span set:html={inline(es ? '[Joven Coro de Andalucía](https://www.instagram.com/reel/Cm4YtCABqNO/), Musikex, clase magistral en la Florida International University' : '[Joven Coro de Andalucía](https://www.instagram.com/reel/Cm4YtCABqNO/), Musikex, masterclass at Florida International University')} /><br />
          <b>{es ? 'Idiomas' : 'Languages'}</b> · {es ? 'Asesor lingüístico de la Film Symphony Orchestra y del Coro Nacional de España' : 'Language coach for the Film Symphony Orchestra and the Spanish National Choir'}
        </p>
        <p class="wook">
          {es ? 'Y el ' : 'And the '}<button type="button" class="linkbtn" data-yt={wookiee.yt} aria-label={`${tr(ui.play, lang)}: Lamento della wookiee`}>{es ? '«Lamento della wookiee»' : '“Lamento della wookiee”'}</button>
          {es ? ' (Monteverdi + Star Wars): el éxito de la ' : ' (Monteverdi + Star Wars): the early music hit of the lockdown.'}
          {es && <><i lang="en">early music</i> durante el confinamiento.</>}
        </p>
        <a class="more" href={url('beyond', lang)}>{tr(ui.nav.beyond, lang)} →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: clamp(24px, 3vw, 48px); max-width: 1440px; margin-inline: auto; padding: 36px var(--gutter) 40px; }
  .hero__text { padding-left: clamp(0px, 2vw, 24px); }
  .hero h1 { font-size: clamp(3.6rem, 7.4vw, 6.6rem); line-height: 1; letter-spacing: -0.015em; color: var(--vino); }
  .hero__lead { font-size: clamp(1.2rem, 1.65vw, 1.45rem); line-height: 1.5; max-width: 33em; margin: 1.6rem 0 2.1rem; }
  .hero__fig { margin: 0; }
  /* La foto se dimensiona por la altura y conserva su proporción: nunca se recorta. */
  .hero__fig :global(img) { height: min(clamp(520px, calc(100svh - 190px), 880px), 70vw); width: auto; max-width: none; }
  .hero__fig .credit { text-align: right; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-top: 28px; gap: 28px; }
    .hero__text { padding: 0; }
    .hero__fig :global(img) { width: 100%; height: auto; }
  }
</style>
