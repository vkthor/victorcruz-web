---
import Base from '../layouts/Base.astro';
---
<Base lang="es" route="home" title="Página no encontrada" description="Página no encontrada" noindex>
  <section class="section">
    <div class="wrap narrow" style="text-align:center">
      <p class="eyebrow">404</p>
      <h1 class="title" style="font-size:clamp(2.4rem,5vw,3.8rem)">Esta página no existe</h1>
      <p lang="en" style="color:var(--gris)">This page does not exist.</p>
      <p class="btns" style="justify-content:center;margin-top:2rem">
        <a class="btn btn--solid" href="/">Ir a la portada</a>
        <a class="btn" href="/en/" lang="en">Go to the home page</a>
      </p>
    </div>
  </section>
</Base>
